{
  "name": "agent-sidecar",
  "version": "0.12.0",
  "description": "A visual canvas for coding agents: your agent shows interactive HTML artifacts in your browser, and your clicks flow back into the conversation. MCP server.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agent-sidecar": "dist/sidecar.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smarchetti/agent-sidecar.git"
  },
  "homepage": "https://agent-sidecar.vercel.app/",
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "canvas",
    "artifacts",
    "webhook"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build src/sidecar.ts --target=node --outfile=dist/sidecar.js",
    "test": "bun test",
    "test:node": "bun run build && SIDECAR_TEST_RUNTIME=node bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
